{
  "name": "saras",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "AI-assisted email replies, through OpenRouter with Zero Data Retention enforced",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.web.json",
    "start": "node src/main.ts",
    "dev": "tsc -p tsconfig.web.json --watch --preserveWatchOutput & node --watch src/main.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.web.json --noEmit",
    "test": "node --test --test-reporter=spec \"test/*.test.ts\""
  },
  "dependencies": {
    "better-sqlite3": "^12.0.0",
    "express": "^5.1.0",
    "imapflow": "^1.0.0",
    "mailparser": "^3.7.0",
    "nodemailer": "^7.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/smtp-server": "^3.5.13",
    "hoodiecrow-imap": "^2.1.0",
    "smtp-server": "^3.13.0",
    "typescript": "^7.0.2"
  }
}

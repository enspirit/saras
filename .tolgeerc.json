{
  "$schema": "https://docs.tolgee.io/cli-schema.json",
  "format": "JSON_TOLGEE",
  "patterns": [
    "./web/**/*.ts"
  ],
  "push": {
    "filesTemplate": "./public/i18n/{languageTag}/{namespace}.json"
  },
  "pull": {
    "path": "./public/i18n",
    "fileStructureTemplate": "{languageTag}/{namespace}.{extension}"
  }
}

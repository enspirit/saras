{
  "$schema": "https://docs.tolgee.io/cli-schema.json",
  "format": "JSON_TOLGEE",
  "patterns": ["./web/**/*.ts"],
  "push": {
    "files": [
      { "path": "./public/i18n/fr.json", "language": "fr" },
      { "path": "./public/i18n/en.json", "language": "en" }
    ]
  },
  "pull": {
    "path": "./public/i18n"
  }
}

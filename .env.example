# --- Obligatoire -------------------------------------------------------------
# Clé maîtresse : chiffre les mots de passe IMAP/SMTP, tokens OAuth et clés API
# stockés en base. Générez-la avec : openssl rand -hex 32
# Ne la perdez pas et ne la changez pas : les comptes connectés deviendraient illisibles.
APP_SECRET=

# Clé OpenRouter (https://openrouter.ai/keys). Peut aussi être saisie par
# utilisateur dans Réglages.
OPENROUTER_API_KEY=

# --- Optionnel ---------------------------------------------------------------
PORT=3000
# URL publique de l'application (sert aux redirections OAuth et au cookie Secure)
BASE_URL=http://localhost:3000
DATA_DIR=./data
# Dossier de marque (theme.css, brand.json, logo, favicon). Vide = marque par défaut.
# Exemple fourni : BRAND_DIR=./brands/exemple
BRAND_DIR=
# Modèle par défaut (identifiant OpenRouter). Doit avoir au moins un fournisseur ZDR.
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# Inscription libre. Par défaut fermée : le premier compte créé devient administrateur,
# les suivants arrivent sur invitation (page Utilisateurs).
ALLOW_SIGNUP=false
# Durée de validité d'un lien d'invitation (jours)
INVITATION_DAYS=7
# Synchronisation automatique (minutes). 0 = uniquement manuelle.
SYNC_INTERVAL_MINUTES=10
# Fenêtre de récupération des emails (jours) et nombre max par synchronisation
SYNC_DAYS=7
SYNC_MAX_EMAILS=50
# Effacement automatique du contenu des emails après N jours (0 = jamais)
RETENTION_DAYS=30

# OAuth Google (Gmail) — https://console.cloud.google.com/apis/credentials
# URI de redirection : {BASE_URL}/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth Microsoft (Outlook / Microsoft 365) — https://entra.microsoft.com
# URI de redirection : {BASE_URL}/api/oauth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

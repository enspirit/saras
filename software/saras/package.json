{
  "name": "saras",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "AI-assisted email replies, through OpenRouter with Zero Data Retention enforced",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "start": "node src/main.ts",
    "dev": "node scripts/build.ts --watch & node --watch src/main.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.web.json",
    "test": "node --test --test-reporter=spec \"test/**/*.test.ts\"",
    "test:unit": "node --test --test-reporter=spec \"test/unit/*.test.ts\"",
    "test:integration": "node --test --test-reporter=spec \"test/integration/*.test.ts\""
  },
  "dependencies": {
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.8",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@electric-sql/pglite": "^0.5.17",
    "@enspirit/codemirror-lang-elo": "0.1.0",
    "@enspirit/elo": "1.2.4",
    "@lezer/highlight": "1.2.5",
    "codemirror": "6.0.2",
    "express": "^5.1.0",
    "imapflow": "^1.0.0",
    "luxon": "3.7.2",
    "mailparser": "^3.7.0",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/luxon": "3.7.6",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/smtp-server": "^3.5.13",
    "acorn": "8.19.0",
    "dompurify": "^3.4.18",
    "esbuild": "0.28.2",
    "hoodiecrow-imap": "^2.1.0",
    "lucide-static": "1.77.0",
    "smtp-server": "^3.13.0",
    "squire-rte": "^2.4.11",
    "typescript": "^7.0.2"
  }
}

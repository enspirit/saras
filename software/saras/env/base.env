# What saras is configured by: every variable the server reads, with the value
# it takes when nothing else is said. This file is the one place where they
# are described, and a test holds it to the code (test/unit/configuration.test.ts).
#
# The stack loads it first (docker-compose.base.yml); env/devel.env, then
# env/test.env under the suites, then `.env` on a laptop, change what they
# say. An installation run without the stack sets what it changes in its own
# `.env`, from .env.example.
#
# Nothing secret: a secret is named here and left empty, and its value goes in
# `.env`, which is not committed.

# --- Required ----------------------------------------------------------------
# A secret. Master key: encrypts the IMAP/SMTP passwords, OAuth tokens and API
# keys stored in the database. Generate it with: openssl rand -hex 32
# Do not lose it and do not change it: connected mailboxes would become unreadable.
APP_SECRET=

# --- The installation ---------------------------------------------------------
PORT=3000
# Public URL of the application (used for OAuth redirects, invitation links and
# the Secure cookie). Empty: http://localhost:PORT
BASE_URL=
# Database. Empty: the embedded PostgreSQL, stored in DATA_DIR — nothing to
# install, meant for trying the tool and for development.
# For a real deployment, a PostgreSQL server:
#   DATABASE_URL=postgres://user:password@host:5432/saras
DATABASE_URL=
DATA_DIR=./data
# What this process takes on, of what a server does:
#   migrate  bringing the database to what this version expects, when it starts
#   web      answering over HTTP: the API and the interface
#   clock    what the server does on its own: fetching the mailboxes, erasing
#            what is past its retention, forgetting expired sessions
# All three: one process is a whole installation. Several processes may run on
# one PostgreSQL server, each with all three or with some: a migration is
# applied once and a task of the clock is run by one of them, whatever their
# number. A process without `migrate` waits for the database to be migrated;
# `migrate` alone applies the migrations and ends.
ROLES=migrate,web,clock
# Brand folder (theme.css, brand.json, logo, favicon). Empty: the default brand.
# An example is provided: BRAND_DIR=./brands/example
BRAND_DIR=

# --- The LLM ------------------------------------------------------------------
# A secret. OpenRouter key (https://openrouter.ai/keys) of the server: used by
# organisations that have not entered their own. If you host organisations that
# are not yours, leave it empty so that each one pays for its own usage with
# its own key (set in its settings).
OPENROUTER_API_KEY=
# Default model (OpenRouter identifier). Must have at least one ZDR provider.
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# Where OpenRouter is reached. The suites point it where nothing listens.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Who may join -------------------------------------------------------------
# Signing up creates an organisation, administered by whoever signs up; its other members
# join by invitation. Closed by default: only the first organisation can be created.
# Set to true to let anyone create an organisation.
ALLOW_SIGNUP=false
# Validity of an invitation link (days)
INVITATION_DAYS=7
# Second factor. true: every member is asked, besides their password, for a code from an
# authenticator app (TOTP); they set it up at their first sign-in and are given recovery
# codes. false: passwords alone. Turning it off later keeps what members set up, unused.
MFA_ENABLED=false

# --- The server's own outgoing mail -------------------------------------------
# Used only to send the link of a lost password. Both empty: no email is sent,
# and an administrator gives the link instead (Users page).
# SMTP_URL holds a password: a secret.
#   SMTP_URL=smtps://user:password@smtp.example.com:465
#   MAIL_FROM=saras <no-reply@example.com>
SMTP_URL=
MAIL_FROM=

# --- Sorting, fetching, keeping -----------------------------------------------
# Whether a NEW organisation sets plainly automated mail (newsletters, no-reply senders…)
# aside, by a rule it can read and change. Every other email of the watched folder is to
# be handled: no LLM sorts.
TRIAGE_SKIP_AUTOMATED=true
# Automatic synchronisation (minutes). 0 = manual only.
SYNC_INTERVAL_MINUTES=10
# How far back emails are fetched (days) and the maximum number per synchronisation
SYNC_DAYS=7
SYNC_MAX_EMAILS=50
# Email content is erased after N days (0 = never)
RETENTION_DAYS=30

# --- Mail hosts members sign in at ---------------------------------------------
# Google OAuth (Gmail) — https://console.cloud.google.com/apis/credentials
# Redirect URI: {BASE_URL}/api/oauth/google/callback
# GOOGLE_CLIENT_SECRET is a secret.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft OAuth (Outlook / Microsoft 365) — https://entra.microsoft.com
# Redirect URI: {BASE_URL}/api/oauth/microsoft/callback
# MICROSOFT_CLIENT_SECRET is a secret.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

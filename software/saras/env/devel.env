# What the development stack changes of env/base.env. Loaded after it and
# after .env.commons, so it wins over both; `.env`, when there is one, is
# loaded after this file and wins in turn.
#
# Nothing secret. A real key goes in .env at the repository root.

# Visibly a development value: it seals what the development database keeps,
# and nothing else. An installation generates its own (openssl rand -hex 32).
APP_SECRET=dev-only-insecure-app-secret-0123456789abcdef

# Anyone on this machine may create an organisation: the port is published on
# localhost only, and the black-box suite starts from there.
ALLOW_SIGNUP=true

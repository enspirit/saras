# What the development stack changes of env/base.env. Loaded after it and
# after .env.commons, so it wins over both.
#
# Nothing secret is written here. What a laptop's `.env` may give the server
# is *named* here, as ${NAME:-default}: compose fills it from the environment
# `emb` loaded `.env` into. A variable of `.env` that this file does not name
# does not reach the container.

# The address the server is reached at: the one of `.env` when it has one (a
# tunnel, a name of yours), else where this stack publishes it.
BASE_URL=${BASE_URL:-http://localhost:${SARAS_PORT:-3000}}

# The default brand, unless SARAS_BRAND names a folder of software/saras/brands
# (SARAS_BRAND=klaro in .env, or in the shell).
BRAND_DIR=${SARAS_BRAND:+/app/brands/}${SARAS_BRAND:-}

# Anyone on this machine may create an organisation: the port is published on
# localhost only, and the black-box suite starts from there.
ALLOW_SIGNUP=true

# --- From .env, when it has them -----------------------------------------------
# The default is visibly a development value: it seals what the development
# database keeps, and nothing else.
APP_SECRET=${APP_SECRET:-dev-only-insecure-app-secret-0123456789abcdef}

# How much the server says of what it does: LOG_LEVEL=debug in .env to follow
# a request to a mail server and back (`emb logs saras`, one JSON object per line).
LOG_LEVEL=${LOG_LEVEL:-info}

# The LLM: without a key, everything that needs no AI works. The model and the
# address default to those of env/base.env (a test holds them equal).
OPENROUTER_API_KEY=${OPENROUTER_API_KEY:-}
OPENROUTER_MODEL=${OPENROUTER_MODEL:-anthropic/claude-sonnet-4.5}
OPENROUTER_BASE_URL=${OPENROUTER_BASE_URL:-https://openrouter.ai/api/v1}

# The server's own outgoing mail: the stack's mail server, which delivers
# nothing and shows what it was given on http://localhost:1080 (world/fakesmtp),
# unless .env names a real one. `ignoreTLS`: it offers an upgrade to TLS with
# a certificate that expired long ago, and the mail goes no further than the
# compose network.
SMTP_URL=${SMTP_URL:-smtp://fakesmtp:25?ignoreTLS=true}
MAIL_FROM=${MAIL_FROM:-saras <no-reply@saras.example>}

# The OAuth applications.
GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID:-}
GOOGLE_CLIENT_SECRET=${GOOGLE_CLIENT_SECRET:-}
MICROSOFT_CLIENT_ID=${MICROSOFT_CLIENT_ID:-}
MICROSOFT_CLIENT_SECRET=${MICROSOFT_CLIENT_SECRET:-}

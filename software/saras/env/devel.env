# How this container sees the stack: its own listen port, and what it cannot
# start without. Loaded after .env.commons, so it wins over it; `.env`, when
# there is one, is loaded after this file and wins in turn.
#
# Nothing secret. A real key goes in .env at the repository root.
PORT=3000

# Visibly a development value: it seals what the development database keeps,
# and nothing else. An installation generates its own (openssl rand -hex 32).
APP_SECRET=dev-only-insecure-app-secret-0123456789abcdef

# Only what the suites change, loaded after env/devel.env in
# docker-compose.test.yml.

# How the suites reach it: by service name, on the compose network.
BASE_URL=http://saras:3000

# Nothing happens that a suite did not ask for.
SYNC_INTERVAL_MINUTES=0

# --- Whatever a laptop's .env holds, the suites see none of it -----------------
# env/devel.env takes these from the environment; each is pinned here, so that
# no suite depends on a secret, spends money or sends a mail (a test holds the
# two lists equal).
# The development value of env/devel.env: the one the seeds of
# software/storage are sealed with.
APP_SECRET=dev-only-insecure-app-secret-0123456789abcdef
OPENROUTER_API_KEY=
OPENROUTER_MODEL=test/model
# An address where nothing listens.
OPENROUTER_BASE_URL=http://127.0.0.1:9
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
SMTP_URL=
MAIL_FROM=

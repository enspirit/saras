# Only what the suites change, loaded after env/devel.env in
# docker-compose.test.yml.

# How the suites reach it: by service name, on the compose network.
BASE_URL=http://saras:3000

# No suite can spend money or reach the real LLM: there is no key (env/base.env
# has none, and .env is not read), and the address is one where nothing listens.
OPENROUTER_BASE_URL=http://127.0.0.1:9

# Nothing happens that a suite did not ask for.
SYNC_INTERVAL_MINUTES=0

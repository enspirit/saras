# Only what the suites change, loaded after devel.env in docker-compose.test.yml.

# No suite can spend money or reach the real LLM: no key, and an address where
# nothing listens.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=http://127.0.0.1:9

# Suites create the organisations they need.
ALLOW_SIGNUP=true

# Nothing happens that a suite did not ask for.
SYNC_INTERVAL_MINUTES=0

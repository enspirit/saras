# What an installation says of itself: copy to .env, which is not committed.
#
#   cp .env.example .env
#
# Every variable saras reads is described in env/base.env, with its default.
# Only the first one below is required; add here any other you want to change
# (BASE_URL, DATABASE_URL, ALLOW_SIGNUP, RETENTION_DAYS…).

# Master key: encrypts what the database keeps of your mailboxes.
# Generate it with: openssl rand -hex 32. Do not lose it and do not change it.
APP_SECRET=

# OpenRouter key of the server (https://openrouter.ai/keys). Empty: each
# organisation enters its own.
OPENROUTER_API_KEY=

# The secrets of the OAuth applications and of the outgoing mail, when you set
# them up (their other halves are in env/base.env):
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# SMTP_URL=
# MAIL_FROM=

# --- Required ----------------------------------------------------------------
# Master key: encrypts the IMAP/SMTP passwords, OAuth tokens and API keys stored
# in the database. Generate it with: openssl rand -hex 32
# Do not lose it and do not change it: connected mailboxes would become unreadable.
APP_SECRET=

# OpenRouter key (https://openrouter.ai/keys) of the server: used by organisations and
# users who have not entered their own. If you host organisations that are not yours, leave
# it empty so that each one pays for its own usage with its own key (set in its settings).
OPENROUTER_API_KEY=

# --- Optional ----------------------------------------------------------------
PORT=3000
# Public URL of the application (used for OAuth redirects, invitation links and
# the Secure cookie)
BASE_URL=http://localhost:3000
# Database. Leave DATABASE_URL empty to use the embedded PostgreSQL, stored in DATA_DIR:
# nothing to install, meant for trying the tool and for development.
# For a real deployment, point it at a PostgreSQL server:
#   DATABASE_URL=postgres://user:password@host:5432/saras
# With docker compose, DATABASE_URL is set for you from POSTGRES_PASSWORD below.
DATABASE_URL=
DATA_DIR=./data
# Password of the PostgreSQL service of world/compose/docker-compose.yml (openssl rand -hex 24).
# Letters and digits only: it is placed in a URL.
POSTGRES_PASSWORD=
# Brand folder (theme.css, brand.json, logo, favicon). Empty = default brand.
# An example is provided: BRAND_DIR=./brands/example
BRAND_DIR=
# Default model (OpenRouter identifier). Must have at least one ZDR provider.
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# Signing up creates an organisation, administered by whoever signs up; its other members
# join by invitation. Closed by default: only the first organisation can be created.
# Set to true to let anyone create an organisation.
ALLOW_SIGNUP=false
# Validity of an invitation link (days)
INVITATION_DAYS=7
# Second factor. true: every member is asked, besides their password, for a code from an
# authenticator app (TOTP); they set it up at their first sign-in and are given recovery
# codes. false: passwords alone. Turning it off later keeps what members set up, unused.
MFA_ENABLED=false
# The server's own outgoing mail, used only to send the link of a lost password.
# Both empty: no email is sent, and an administrator gives the link instead (Users page).
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=saras <no-reply@example.com>
SMTP_URL=
MAIL_FROM=
# How a NEW organisation sorts fetched emails into "a reply is needed" or not (each
# organisation then changes it in its own settings):
#   none  no analysis: every email of the watched folder is to be handled (default)
#   ai    an LLM decides and suggests a prompt, one request per 20 emails
TRIAGE_STRATEGY=none
# Whether a new organisation sets plainly automated mail (newsletters, no-reply senders…)
# aside before any triage.
TRIAGE_SKIP_AUTOMATED=true
# Automatic synchronisation (minutes). 0 = manual only.
SYNC_INTERVAL_MINUTES=10
# How far back emails are fetched (days) and the maximum number per synchronisation
SYNC_DAYS=7
SYNC_MAX_EMAILS=50
# Email content is erased after N days (0 = never)
RETENTION_DAYS=30

# Google OAuth (Gmail) — https://console.cloud.google.com/apis/credentials
# Redirect URI: {BASE_URL}/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft OAuth (Outlook / Microsoft 365) — https://entra.microsoft.com
# Redirect URI: {BASE_URL}/api/oauth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

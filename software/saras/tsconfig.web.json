{
  // Browser code: web/ and shared/. Only type-checked here; scripts/build.ts bundles it into public/js/.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    "noEmit": true
  },
  "include": ["web", "shared"]
}

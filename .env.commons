# Shared, non-secret defaults. Secrets go in .env, which is not committed.
#
# `emb` loads this file for every task, and it wins over `.env`: a value meant
# to be overridden on one machine stays out of it.

# Which compose file makes up the stack. Docker Compose's own variable, and
# what `emb up` reads to find the services.
COMPOSE_FILE=docker-compose.yml

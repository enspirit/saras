# Shared, non-secret defaults. Secrets go in .env, which is not committed.
#
# Every name in this file is the running stack's vocabulary. `emb` loads it for
# every task, and it wins over `.env`: a value meant to be overridden on one
# machine stays out of it.

# Which compose files make up the stack. Docker Compose's own variable, and
# what `emb up` reads to find the services.
#
#   COMPOSE_FILE=docker-compose.base.yml:docker-compose.test.yml emb up
#
# base says what a component *is*; devel adds ports, env files and bind mounts;
# test adds the suites' env and publishes no port.
COMPOSE_FILE=docker-compose.base.yml:docker-compose.devel.yml

# The database of the stack, and what a task running on the *host* should
# reach: localhost and the published port. The server's own view of it is the
# DATABASE_URL composed in docker-compose.base.yml.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=saras
POSTGRES_USER=saras

# Published port: what you open in a browser. saras listens on 3000 *inside*
# its container; this is the host-side number only.
SARAS_PORT=3000

# Where the stack shows the mail saras gave it to send (world/fakesmtp).
FAKESMTP_PORT=1080

# Shared, non-secret defaults. Secrets go in .env, which is not committed.
#
# Every name in this file is the running stack's vocabulary. `emb` loads it for
# every task, and it wins over `.env`: a value meant to be overridden on one
# machine stays out of it.

# Which compose files make up the stack. Docker Compose's own variable, and
# what `emb up` reads to find the services.
#
#   COMPOSE_PROJECT_NAME=saras-try COMPOSE_FILE=docker-compose.base.yml:docker-compose.test.yml emb up
#
# base says what a component *is*; devel adds ports, env files and bind mounts;
# test adds the suites' env and publishes no port.
COMPOSE_FILE=docker-compose.base.yml:docker-compose.devel.yml

# --- The ports of this machine the stack takes -------------------------------
# 72, then the two digits the usual port starts with: 3000 is 7230, 5432 is
# 7254, 1080 is 7210. 72 is S and A on the keys of a phone, and a range nothing
# else is known to take: the stack starts beside another project's
# (doc/decisions/0018). Host-side numbers only: inside its container every
# service keeps its usual port, and the stack under the suites publishes none.
#
# The same numbers are the fallbacks of docker-compose.devel.yml,
# software/saras/env/devel.env and bin/demo, for a `docker compose` run
# without `emb`: change them together.

# What you open in a browser.
SARAS_PORT=7230

# The database of the stack, and what a task running on the *host* should
# reach: localhost and the published port. The server's own view of it is the
# DATABASE_URL composed in docker-compose.base.yml.
POSTGRES_HOST=localhost
POSTGRES_PORT=7254
POSTGRES_DB=saras
POSTGRES_USER=saras

# Where the stack shows the mail saras gave it to send (world/fakesmtp).
FAKESMTP_PORT=7210

# The explorer of the operations (tests/operations: `emb run explorer:serve`), on the host:
# 8080 is its usual port, so 7280.
EXPLORER_PORT=7280

# What reads the specifications of the operations and runs them (tests/operations): opspicy, a
# project of its own, as the image of one of its versions. Named here and nowhere else: the
# image of the suite is built on it, and the suite's tasks on a checkout run it.
OPSPICY_IMAGE=enspirit/opspicy:0.2.0

#!/usr/bin/env bash
# What `emb run compose:lint` checks of the operator's compose file.
set -euo pipefail
cd "$(dirname "$0")"

# It is a file docker compose accepts. Without an operator's .env: the one
# variable the file requires is given here, and the file it reads is not asked
# for.
POSTGRES_PASSWORD=lint docker compose --env-file /dev/null -f docker-compose.yml config --quiet --no-env-resolution

# It runs the PostgreSQL the suites run on. The image is pinned in
# docker-compose.base.yml and named a second time here, for an operator who
# has only this file: the two are held equal.
image_of() { grep -E '^\s+image:\s*postgres:' "$1" | awk '{print $2}'; }
tested=$(image_of ../../docker-compose.base.yml)
deployed=$(image_of docker-compose.yml)
if [ -z "$tested" ] || [ "$tested" != "$deployed" ]; then
  echo "world/compose runs '$deployed', the stack is tested on '$tested': name the same image in both." >&2
  exit 1
fi

# The suite's own toolchain. Generate the lockfile once:
#
#   docker run --rm -v "$PWD:/app" -w /app ruby:3.3 bundle lock
#
# `http` is pinned to 5.x on purpose: webspicy 1.1 allows `>= 5.0, < 7.0` but
# calls the verb methods in a way http 6 removed — every request then fails
# with `wrong number of arguments`. Pin it until webspicy's own dependency
# says 6.
source 'https://rubygems.org'

gem 'webspicy', '~> 1.1'
gem 'http', '~> 5.3'

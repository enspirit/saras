# What the suite is configured by, in every stack.

# The front door, as this container reaches it: by service name, on the compose
# network. An origin, with no path.
SARAS_API=http://saras:3000

# dbagent, which installs the seed a case starts from. Beside the front door,
# never through it.
STORAGE_API=http://storage:9292

# Two more, which no file can say and the compose files do:
#
#   DATABASE_URL                        where the relations of state.yml are read, and never
#                                       written: composed in docker-compose.base.yml from the
#                                       variables postgres itself reads.
#   OPERATIONS_MAY_EMPTY_THE_DATABASE   `yes` where the database is the suites' own, and there
#                                       only: docker-compose.test.yml. Without it nothing runs.

# The data saras exchanges, in Elo (elo-lang.org): what software/saras/shared/
# says in TypeScript, and what TypeScript cannot say (a length, a number that
# names something, a list that is not empty). The suite checks every answer
# against them; the server checks what an operation is given against the type
# of its input, and refuses what does not fit (decision 0021).
#
# One file per area, read after this one, in the order of the areas' names: a
# type is declared before it is used, so one that two areas use is declared here.
#
# A schema is closed: an attribute it does not name is refused. `:?` is an
# attribute that may be absent, `.` anything.

# What saras says when it refuses: a sentence in English, and the code and
# parameters the interface translates it from.
Refusal = { error: String, code: String, params: . }

# The answer of an operation that tells nothing back.
Done = { ok: Bool }

# What a member is in their organisation: an administrator, or not.
Role = String(r | r == 'admin' || r == 'user')

# The number of something kept: a board, a mailbox, an email, a member.
Id = Int(i | i > 0)
